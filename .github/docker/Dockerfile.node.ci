FROM node:24-alpine

# Fixes OS CVEs the base still ships: alpine images lag their own apk repos, and the Trivy
# gate fails on any fixed HIGH/CRITICAL.
RUN apk --no-cache upgrade

ARG SERVICE_DIR
ARG ARTIFACT_PATH

WORKDIR /repo

COPY tooling/eslint-config ./tooling/eslint-config
COPY ${SERVICE_DIR}/package*.json ./${SERVICE_DIR}/

WORKDIR /repo/${SERVICE_DIR}
RUN npm ci --omit=dev

COPY ${ARTIFACT_PATH} ./dist

CMD ["node", "dist/index.js"]
