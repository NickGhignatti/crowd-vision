FROM alpine:latest

# `alpine:latest` lags its own apk repos, so an already-fixed OS CVE still reds the Trivy
# gate (HIGH/CRITICAL, exit 1) until the base is rebuilt. This takes the fix at build time.
RUN apk --no-cache upgrade

WORKDIR /app

ARG BINARY_PATH

COPY ${BINARY_PATH} /app/main

RUN chmod +x /app/main

ENTRYPOINT ["/app/main"]
