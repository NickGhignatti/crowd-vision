{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowdvision.dev/schemas/collector-routers.schema.json",
  "title": "CollectorRouters",
  "description": "What GET /telemetry/collector answers: the routers a collector may poll, grouped by building. Built by telemetry in Rust, parsed by ap-collector in Python.",
  "type": "object",
  "required": [
    "buildings"
  ],
  "additionalProperties": false,
  "properties": {
    "buildings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/building"
      }
    }
  },
  "$defs": {
    "building": {
      "type": "object",
      "required": [
        "buildingId",
        "routers"
      ],
      "additionalProperties": false,
      "properties": {
        "buildingId": {
          "type": "string",
          "minLength": 1
        },
        "routers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/router"
          }
        }
      }
    },
    "router": {
      "type": "object",
      "required": [
        "sensorId",
        "roomId"
      ],
      "additionalProperties": false,
      "$comment": "No credentials: router logins stay in the collector's local config.",
      "properties": {
        "sensorId": {
          "type": "string",
          "minLength": 1
        },
        "roomId": {
          "type": "string",
          "minLength": 1
        },
        "driver": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
