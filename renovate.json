{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Rome",
  "dependencyDashboard": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "description": "Every major bump lands in its own PR so breaking changes are reviewed one at a time.",
      "matchUpdateTypes": ["major"],
      "addLabels": ["dependencies", "major"]
    },
    {
      "description": "Per-service grouping: one PR per service for all its non-major updates (npm + docker + lang manifests).",
      "matchFileNames": ["frontend/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "frontend",
      "addLabels": ["dependencies", "frontend"]
    },
    {
      "matchFileNames": ["backend/libs/auth-contracts/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "auth-contracts",
      "addLabels": ["dependencies", "auth-contracts"]
    },
    {
      "matchFileNames": ["backend/libs/auth-middleware/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "auth-middleware",
      "addLabels": ["dependencies", "auth-middleware"]
    },
    {
      "matchFileNames": ["backend/libs/auth-policy/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "auth-policy",
      "addLabels": ["dependencies", "auth-policy"]
    },
    {
      "matchFileNames": ["backend/chat/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "chat",
      "addLabels": ["dependencies", "chat"]
    },
    {
      "matchFileNames": ["backend/digital-twin/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "digital-twin",
      "addLabels": ["dependencies", "digital-twin"]
    },
    {
      "matchFileNames": ["backend/notification/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "notification",
      "addLabels": ["dependencies", "notification"]
    },
    {
      "matchFileNames": ["backend/telemetry/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "telemetry",
      "addLabels": ["dependencies", "telemetry"]
    },
    {
      "matchFileNames": ["backend/socket/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "socket",
      "addLabels": ["dependencies", "socket"]
    },
    {
      "matchFileNames": ["backend/agent/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "agent",
      "addLabels": ["dependencies", "agent"]
    },
    {
      "matchFileNames": ["backend/dashboard/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "dashboard",
      "addLabels": ["dependencies", "dashboard"]
    },
    {
      "matchFileNames": ["backend/acceptance/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "backend-tests",
      "addLabels": ["dependencies", "backend-tests"]
    },
    {
      "matchFileNames": ["simulators/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "simulators",
      "addLabels": ["dependencies", "simulators"]
    },
    {
      "matchFileNames": ["tooling/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "tooling",
      "addLabels": ["dependencies", "tooling"]
    },
    {
      "description": "Repo-level CI: GitHub Actions + mise toolchain.",
      "matchManagers": ["github-actions", "mise"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "ci",
      "addLabels": ["dependencies", "ci"]
    }
  ]
}
