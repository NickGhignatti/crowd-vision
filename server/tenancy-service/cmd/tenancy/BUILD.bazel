load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/oci:defs.bzl", "service_image")

go_library(
    name = "tenancy_lib",
    srcs = ["main.go"],
    importpath = "github.com/NickGhignatti/crowd-vision/server/tenancy-service/cmd/tenancy",
    visibility = ["//visibility:private"],
    deps = [
        "//server/tenancy-service/internal/api",
        "//server/tenancy-service/internal/config",
        "//server/tenancy-service/internal/events",
        "//server/tenancy-service/internal/service",
        "//server/tenancy-service/internal/store",
        "@com_github_go_chi_chi_v5//:chi",
        "@com_github_golang_migrate_migrate_v4//:migrate",
        "@com_github_golang_migrate_migrate_v4//database/postgres",
        "@com_github_golang_migrate_migrate_v4//source/file",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@com_github_redis_go_redis_v9//:go-redis",
    ],
)

go_binary(
    name = "tenancy",
    embed = [":tenancy_lib"],
    visibility = ["//visibility:public"],
)

service_image(
    name = "image",
    binary = ":tenancy",
    migrations = "//server/tenancy-service:migrations",
)
