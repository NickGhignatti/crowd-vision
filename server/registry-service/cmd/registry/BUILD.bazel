load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/oci:defs.bzl", "service_image")

go_library(
    name = "registry_lib",
    srcs = ["main.go"],
    importpath = "github.com/NickGhignatti/crowd-vision/server/registry-service/cmd/registry",
    visibility = ["//visibility:private"],
    deps = [
        "//server/registry-service/internal/api",
        "//server/registry-service/internal/config",
        "//server/registry-service/internal/service",
        "//server/registry-service/internal/store",
        "@com_github_go_chi_chi_v5//:chi",
        "@com_github_golang_migrate_migrate_v4//:migrate",
        "@com_github_golang_migrate_migrate_v4//database/postgres",
        "@com_github_golang_migrate_migrate_v4//source/file",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)

go_binary(
    name = "registry",
    embed = [":registry_lib"],
    visibility = ["//visibility:public"],
)

service_image(
    name = "image",
    binary = ":registry",
    migrations = "//server/registry-service:migrations",
)
