load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/oci:defs.bzl", "go_service_image")

go_library(
    name = "provisioner_lib",
    srcs = ["main.go"],
    importpath = "github.com/NickGhignatti/crowd-vision/server/provisioner/cmd/provisioner",
    visibility = ["//visibility:private"],
    deps = [
        "//server/provisioner/internal/config",
        "//server/provisioner/internal/reconciler",
        "//server/provisioner/internal/registryclient",
        "//server/provisioner/internal/tenancyclient",
    ],
)

go_binary(
    name = "provisioner",
    embed = [":provisioner_lib"],
    visibility = ["//visibility:public"],
)

go_service_image(
    name = "image",
    binary = ":provisioner",
)
