{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "prerelease": true,
      "prerelease-type": "alpha",
      "bump-minor-pre-major": true
    },
    "frontend": {
      "release-type": "node",
      "component": "frontend"
    },
    "backend/chat-service": {
      "release-type": "node",
      "component": "chat-service"
    },
    "backend/notification-service": {
      "release-type": "node",
      "component": "notification-service"
    },
    "backend/sensor-service": {
      "release-type": "node",
      "component": "sensor-service"
    },
    "backend/socket-service": {
      "release-type": "node",
      "component": "socket-service"
    },
    "backend/agent-service": {
      "release-type": "python",
      "component": "agent-service"
    },
    "backend/claims-gateway": {
      "release-type": "go",
      "component": "claims-gateway"
    },
    "backend/provisioner": {
      "release-type": "go",
      "component": "provisioner"
    },
    "backend/registry-service": {
      "release-type": "go",
      "component": "registry-service"
    },
    "backend/tenancy-service": {
      "release-type": "go",
      "component": "tenancy-service"
    },
    "backend/auth-contracts": {
      "release-type": "go",
