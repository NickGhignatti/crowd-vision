      "skip-github-release": true
    },
    "backend/auth-contracts": {
      "release-type": "go",
      "component": "auth-contracts",
      "skip-github-release": true
    },
    "backend/auth-middleware": {
      "release-type": "go",
      "component": "auth-middleware",
      "skip-github-release": true
    },
    "backend/auth-policy": {
      "release-type": "go",
      "component": "auth-policy",
      "skip-github-release": true
    },
    "backend/twin-service": {
      "release-type": "rust",
      "component": "twin-service",
      "skip-github-release": true
    },
    "backend/contracts-service": {
      "release-type": "rust",
      "component": "contracts-service",
      "skip-github-release": true
    }
  }
}
