    },
    "backend/auth-middleware": {
      "release-type": "go",
      "component": "auth-middleware"
    },
    "backend/auth-policy": {
      "release-type": "go",
      "component": "auth-policy"
    },
    "backend/twin-service": {
      "release-type": "rust",
      "component": "twin-service"
    },
    "backend/contracts-service": {
      "release-type": "rust",
      "component": "contracts-service"
    }
  }
}
