{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "prerelease": true,
      "prerelease-type": "alpha",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true
    },
    "frontend": {
      "release-type": "node",
      "component": "frontend",
      "skip-github-release": true
    },
    "backend/chat": {
      "release-type": "rust",
      "component": "chat",
      "skip-github-release": true
    },
    "backend/notification": {
      "release-type": "rust",
      "component": "notification",
      "skip-github-release": true
    },
    "backend/telemetry": {
      "release-type": "rust",
      "component": "telemetry",
      "skip-github-release": true
    },
    "backend/socket": {
      "release-type": "rust",
      "component": "socket",
      "skip-github-release": true
    },
    "backend/agent": {
      "release-type": "python",
      "component": "agent",
      "skip-github-release": true
    },
    "backend/claims-gateway": {
      "release-type": "go",
      "component": "claims-gateway",
      "skip-github-release": true
    },
    "backend/provisioner": {
      "release-type": "go",
      "component": "provisioner",
      "skip-github-release": true
    },
    "backend/registry": {
      "release-type": "go",
      "component": "registry",
      "skip-github-release": true
    },
    "backend/tenancy": {
      "release-type": "go",
      "component": "tenancy",
      "skip-github-release": true
    },
    "backend/libs/auth-contracts": {
      "release-type": "go",
      "component": "auth-contracts",
      "skip-github-release": true
    },
    "backend/libs/auth-middleware": {
      "release-type": "go",
      "component": "auth-middleware",
      "skip-github-release": true
    },
    "backend/libs/auth-policy": {
      "release-type": "go",
      "component": "auth-policy",
      "skip-github-release": true
    },
    "backend/digital-twin": {
      "release-type": "rust",
      "component": "digital-twin",
      "skip-github-release": true
    },
    "backend/dashboard": {
      "release-type": "rust",
      "component": "dashboard",
      "skip-github-release": true
    }
  }
}
