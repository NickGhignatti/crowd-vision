module(
    name = "crowdvision",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.62.0")
bazel_dep(name = "gazelle", version = "0.52.2")
bazel_dep(name = "platforms", version = "1.1.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_work = "//:go.work")
use_repo(go_deps, "com_github_cedar_policy_cedar_go", "com_github_coreos_go_oidc_v3", "com_github_go_chi_chi_v5", "com_github_golang_jwt_jwt_v5", "com_github_golang_migrate_migrate_v4", "com_github_google_uuid", "com_github_jackc_pgx_v5", "com_github_micahparks_jwkset", "com_github_micahparks_keyfunc_v3", "com_github_redis_go_redis_v9", "com_github_testcontainers_testcontainers_go_modules_postgres", "com_github_testcontainers_testcontainers_go_modules_redis")

bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.2.0")
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

# Go services base docker images
oci.pull(
    name = "distroless_static_nonroot",
    image = "gcr.io/distroless/static-debian12",
    digest = "sha256:f5b485ea962d9bd1186b2f6b3a061191539b905b82ec395de78cbfae51f20e35",
    platforms = ["linux/amd64"],
)
use_repo(oci, "distroless_static_nonroot", "distroless_static_nonroot_linux_amd64")

# cc variant due to the need for glibc + ca-certificates
oci.pull(
    name = "distroless_cc_nonroot",
    image = "gcr.io/distroless/cc-debian12",
    digest = "sha256:fccdbb0a547c14e23fcf4ce8ad62ca5d43b4faae8d22cd292f490fef9946c96e",
    platforms = ["linux/amd64"],
)
use_repo(oci, "distroless_cc_nonroot", "distroless_cc_nonroot_linux_amd64")

bazel_dep(name = "rules_rust", version = "0.71.3")
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(edition = "2024")
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "twin_service_crates",
    cargo_lockfile = "//server/twin-service:Cargo.lock",
    manifests = ["//server/twin-service:Cargo.toml"],
)
crate.from_cargo(
    name = "contracts_service_crates",
    cargo_lockfile = "//server/contracts-service:Cargo.lock",
    manifests = ["//server/contracts-service:Cargo.toml"],
)
use_repo(crate, "twin_service_crates", "contracts_service_crates")

bazel_dep(name = "rules_python", version = "1.7.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12")
use_repo(python, "python_3_12")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.12",
    requirements_lock = "//server/agent-service:requirements_lock.txt",
)
use_repo(pip, "pypi")

bazel_dep(name = "aspect_rules_js", version = "3.2.3")
bazel_dep(name = "aspect_rules_ts", version = "3.9.2")
bazel_dep(name = "rules_nodejs", version = "6.7.5")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.0.0")
use_repo(node, "nodejs_toolchains")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")

# Each service owns its dependencies (no root package.json — see CLAUDE.md), so like
# per-service Cargo.lock/uv.lock in Phases 2/3, npm_translate_lock runs once per service
# lockfile rather than one hub for the whole repo. rules_js only understands pnpm-lock.yaml
# natively, not npm's package-lock.json; letting npm_translate_lock's update_pnpm_lock
# auto-run `pnpm import` at build time silently produced an empty lock on Windows (a real
# finding, not a config error — see BAZEL_MIGRATION.md Phase 4), so pnpm-lock.yaml is instead
# pre-generated once via `pnpm import` (like uv export for Python in Phase 3) and checked in.
npm.npm_translate_lock(
    name = "chat_service_npm",
    pnpm_lock = "//server/chat-service:pnpm-lock.yaml",
)
npm.npm_translate_lock(
    name = "notification_service_npm",
    pnpm_lock = "//server/notification-service:pnpm-lock.yaml",
)
npm.npm_translate_lock(
    name = "sensor_service_npm",
    pnpm_lock = "//server/sensor-service:pnpm-lock.yaml",
)
npm.npm_translate_lock(
    name = "socket_service_npm",
    pnpm_lock = "//server/socket-service:pnpm-lock.yaml",
)
use_repo(npm, "chat_service_npm", "notification_service_npm", "sensor_service_npm", "socket_service_npm")

rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")

# TypeScript 6.0.3 isn't in rules_ts's built-in version mirror yet, so the exact
# version + integrity (both from chat-service's package-lock.json) are required.
rules_ts_ext.deps(
    ts_integrity = "sha512-y2TvuxSZPDyQakkFRPZHKFm+KKVqIisdg9/CZwm9ftvKXLP8NRWj38/ODjNbr43SsoXqNuAisEf1GdCxqWcdBw==",
    ts_version = "6.0.3",
)
use_repo(rules_ts_ext, "npm_typescript")
