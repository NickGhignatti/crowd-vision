// Zed reads .zed/settings.json from the worktree root only: without this file,
// opening this folder on its own loses every setting below.
{
  "format_on_save": "on",

  "lsp": {
    "eslint": {
      "settings": {
        "experimental": {
          "useFlatConfig": true
        }
      }
    }
  }
}
